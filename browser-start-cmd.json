{
    "google-chrome": {
      "binary": "google-chrome",
      "args": [
        "--app=${url}",
        "--user-data-dir=${user_path}",
        "--disable-extensions",
        "--disable-infobars",
        "--disable-dev-tools",
        "--no-first-run",
        "--window-size=1200,800"
      ]
    },
