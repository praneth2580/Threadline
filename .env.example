# Dev UI port (Vite). If blocked, Vite tries 5174, 5175, …
DEV_UI_PORT=5173
# API port in dev (backend tries this + next 19 if blocked). UI discovers via GET /api/config.
# API_PORT=3000

# ---------------------------------------------------------------------------
# Scraper
# ---------------------------------------------------------------------------
# Set to "false" to open a visible browser window during scraping
# SCRAPER_HEADLESS=true

# ---------------------------------------------------------------------------
# Chrome MCP — connect to an existing Chrome via CDP remote-debugging port
# Start Chrome with: google-chrome --remote-debugging-port=9222 --user-data-dir=/tmp/chrome-mcp
# If unreachable, the scraper falls back to launching a fresh Chromium process.
# ---------------------------------------------------------------------------
# CHROME_CDP_URL=http://localhost:9222

# ---------------------------------------------------------------------------
# Ollama — local LLM for intelligent profile extraction fallback
# Install: https://ollama.ai/download
# Pull a model: ollama pull llama3   (or mistral, phi3, etc.)
# Start server: ollama serve
# ---------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
