{
  "name": "threadline",
  "version": "1.0.0",
  "description": "Desktop app to visualize social connections. No dependencies, just a Node scraper for session handling and login flows.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:ui": "npm run dev --workspace=ui",
    "dev:backend": "node main.js",
    "dev": "dotenv -e .env -- concurrently --kill-others \"npm:dev:ui\" \"npm:dev:backend\"",
    "build:ui": "npm run build --workspace ui",
    "build": "npm run build:ui && pkg main.js",
    "build:linux": "npm run build:ui && pkg main.js --targets node18-linux-x64",
    "build:win": "npm run build:ui && pkg main.js --targets node18-win-x64",
    "build:mac": "npm run build:ui && pkg main.js --targets node18-macos-x64"
  },
  "pkg": {
    "scripts": [
      "main.js",
      "src/utils/check-browser.js"
    ],
    "assets": [
      "ui/dist/**/*",
      "browser-start-cmd.json"
    ],
    "outputPath": "dist",
    "targets": [
      "node18-linux-x64",
      "node18-win-x64",
      "node18-macos-x64"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "concurrently": "^9.2.1"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "pkg": "^5.8.1"
  }
}
